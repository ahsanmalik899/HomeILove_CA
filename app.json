{
  "expo": {
    "scheme": "homeiloveca",
    "name": "Homeilove.ca",
    "slug": "homeilove-ca",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon 1024x1024.png",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo/logo-black.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.revnosoft.homeilove.ca",
      "associatedDomains": [
        "applinks:homeilove.ca"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/app-icon 1024x1024.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDDA_akLPvpnNifHJNaEBdixs1dHaJmbbw"
        }
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "homeilove.ca",
              "pathPrefix": "/CreateNewpass"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "homeilove.ca",
              "pathPrefix": "/Account"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "homeilove.ca",
              "pathPrefix": "/NewsFeedSingelView"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "homeilove.ca",
              "pathPrefix": "/AddSingleView"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "homeilove.ca",
              "pathPrefix": "/postRedirect"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "package": "com.revnosoft.homeilove.ca"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
       [
        "react-native-share",
        {
          "ios": [
            "whatsapp",
            "fb",
            "twitter"
          ],
          "android": [
            "com.whatsapp",
            "com.facebook.katana",
            "com.linkedin.android",
            "com.twitter.android"
          ]
        }
      ],
       [
    "expo-build-properties",
    {
      "android": {
        "enableMinifyInReleaseBuilds": true,
        "enableShrinkResourcesInReleaseBuilds": true
      }
    }
  ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "GOOGLE_MAPS_API_KEY": "AIzaSyDDA_akLPvpnNifHJNaEBdixs1dHaJmbbw",
      "eas": {
        "projectId": "36bcc7f1-37fb-4022-aa0f-0954fa27c753"
      }
    }
  }
}
