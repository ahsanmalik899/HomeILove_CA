{
  "expo": {
    "scheme": "homeilove",
    "name": "Home-I-Love",
    "slug": "home-i-love",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/logo.png",
    "newArchEnabled": true,
    "deepLinking": true,
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo/logo.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.revnosoft.homeilove",
      "associatedDomains": [
        "applinks:homeilove.app",
        "applinks:homeilove.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "QUERY_ALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/logo.png",
        "backgroundColor": "#ffffff"
      },
       "config": {
    "googleMaps": {
      "apiKey": "AIzaSyCcUdqUPvVaJYw1IcCL1PvsUQJ99-tuHiY"
    }
  },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "homeilove.us",
              "pathPrefix": "/CreateNewpass"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "homeilove.us",
              "pathPrefix": "/Account"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "package": "com.revnosoft.homeilove"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-web-browser"
    ],
    "extra": {
    
      "router": {
        "origin": false
      },
       "GOOGLE_MAPS_API_KEY": "AIzaSyCcUdqUPvVaJYw1IcCL1PvsUQJ99-tuHiY",
      "eas": {
        "projectId": "e370ca21-f752-4295-8201-cdd94e014280"
      }
    }
  }
}
